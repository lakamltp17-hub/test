        // FIXED GOOGLE SHEETS SYNC ENGINE (Added redirect: follow & error catching)
        async function syncGoogleSheetsData() {
            const badge = document.getElementById('gsheets-status-badge');
            const syncText = document.getElementById('gsheets-last-sync-text');
            const btnSync = document.getElementById('btn-sync-gsheets');

            if (!gsheetsConfigUrl) {
                if(badge) {
                    badge.className = "inline-flex items-center px-3 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300";
                    badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-500 me-1.5 animate-pulse"></span> Demo Mode (Data Lokal)`;
                }
                if(syncText) syncText.innerText = "Belum terhubung. Klik 'Hubungkan Google Sheet' untuk menghubungkan.";
                renderSuratTable(DATA_SURAT_DEMO);
                updateStatsCounters();
                return;
            }

            if(btnSync) btnSync.classList.add('opacity-50', 'pointer-events-none');
            if(badge) {
                badge.className = "inline-flex items-center px-3 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-300";
                badge.innerHTML = `<i class="fa-solid fa-spinner fa-spin me-1.5"></i> Menghubungkan Google Sheets...`;
            }

            try {
                const response = await fetch(gsheetsConfigUrl, {
                    method: "GET",
                    redirect: "follow"
                });
                
                if (!response.ok) throw new Error("Gagal mengambil data dari Google Sheets API");

                let fetchedData = await response.json();

                if (Array.isArray(fetchedData) && fetchedData.length > 0) {
                    DATA_SURAT_PUPR = fetchedData.map((item, idx) => {
                        const namaPJ = item.PenanggungJawab || "Staf Teknis PUPR";
