        // Filtering Table
        function filterSuratTable() {
            const query = document.getElementById('search-surat-input').value.toLowerCase();
            const filtered = DATA_SURAT_PUPR.filter(item => {
                const matchStatus = (currentActiveStatusFilter === 'ALL') || (item.status === currentActiveStatusFilter);
                const matchText = (item.nomorSurat || '').toLowerCase().includes(query) ||
                                  (item.perihalSurat || '').toLowerCase().includes(query) ||
                                  (item.asalSurat || '').toLowerCase().includes(query) ||
                                  ((item.pj && item.pj.nama) || '').toLowerCase().includes(query);
                return matchStatus && matchText;
            });
            renderSuratTable(filtered);
        }

        function setFilterStatus(status) {
            currentActiveStatusFilter = status;
            document.querySelectorAll('.status-btn').forEach(btn => {
                btn.classList.remove('bg-pupr-blue', 'text-white', 'shadow-sm');
                btn.classList.add('bg-slate-100', 'text-slate-600');
            });

            if(status === 'ALL') document.getElementById('btn-status-all').className = 'status-btn active-status-btn px-4 py-2 rounded-xl text-xs font-bold transition bg-pupr-blue text-white shadow-sm';
            if(status === 'SELESAI') document.getElementById('btn-status-selesai').className = 'status-btn active-status-btn px-4 py-2 rounded-xl text-xs font-bold transition bg-pupr-blue text-white shadow-sm';
            if(status === 'PROSES') document.getElementById('btn-status-proses').className = 'status-btn active-status-btn px-4 py-2 rounded-xl text-xs font-bold transition bg-pupr-blue text-white shadow-sm';
