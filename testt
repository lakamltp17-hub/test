<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dinas Pekerjaan Umum & Penataan Ruang Kota Ambon</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        pupr: {
                            blue: '#0F3854',
                            lightblue: '#1E5276',
                            yellow: '#FFB800',
                            hoverYellow: '#E5A600',
                            dark: '#081627',
                            slate: '#F8FAFC'
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        .glass-card {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }
        .hero-overlay {
            background: linear-gradient(135deg, rgba(15, 56, 84, 0.94) 0%, rgba(8, 22, 39, 0.88) 100%);
        }
        .yellow-glow {
            box-shadow: 0 10px 30px -5px rgba(255, 184, 0, 0.45);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 9999px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #FFB800;
        }
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        .animate-float {
            animation: floatSlow 4s ease-in-out infinite;
        }
    </style>
</head>
<body class="bg-slate-50 font-sans text-slate-800 antialiased selection:bg-pupr-yellow selection:text-pupr-blue">

    <!-- Top Bar Info -->
    <div class="bg-pupr-dark text-slate-300 text-xs py-2 px-4 sm:px-8 flex justify-between items-center border-b border-slate-800">
        <div class="flex items-center space-x-4">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-location-dot text-pupr-yellow"></i> Jl. Yan Paays No. 30, Kelurahan Ahusen, Kecamatan Sirimau, Kota Ambon, Maluku</span>
            <span class="hidden md:flex items-center gap-1.5"><i class="fa-solid fa-clock text-pupr-yellow"></i> Jam Kerja: 08:00 - 16:30 WIT</span>
        </div>
        <div class="flex items-center space-x-3">
            <a href="tel:0911312757" class="hover:text-pupr-yellow transition flex items-center gap-1"><i class="fa-solid fa-phone text-pupr-yellow"></i> (0911) 312757</a>
            <span class="text-slate-700">|</span>
            <div class="flex space-x-2">
                <a href="#" class="w-6 h-6 rounded-full bg-slate-800 flex items-center justify-center hover:bg-pupr-yellow hover:text-pupr-blue transition"><i class="fa-brands fa-facebook-f text-[10px]"></i></a>
                <a href="#" class="w-6 h-6 rounded-full bg-slate-800 flex items-center justify-center hover:bg-pupr-yellow hover:text-pupr-blue transition"><i class="fa-brands fa-instagram text-[10px]"></i></a>
                <a href="#" class="w-6 h-6 rounded-full bg-slate-800 flex items-center justify-center hover:bg-pupr-yellow hover:text-pupr-blue transition"><i class="fa-brands fa-youtube text-[10px]"></i></a>
            </div>
        </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">
                
                <!-- Branding & City Logo -->
                <div class="flex items-center space-x-3">
                    <img src="Lambang_Ambon.png" 
                         alt="Logo Pemkot Ambon" 
                         class="h-12 w-auto object-contain drop-shadow-sm hover:scale-105 transition"
                         onerror="this.src='https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=200&auto=format&fit=crop'">
                    
                    <div class="h-9 w-px bg-slate-200"></div>

                    <div class="flex flex-col">
                        <div class="flex items-center gap-1.5">
                            <span class="text-[10px] font-extrabold uppercase tracking-wider text-pupr-blue bg-pupr-yellow px-2 py-0.5 rounded-full">
                                Pemkot Ambon
                            </span>
                            <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200 flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> E-Disposisi Active
                            </span>
                        </div>
                        <span class="text-xs sm:text-sm font-extrabold text-pupr-blue leading-tight tracking-tight mt-0.5">
                            Dinas Pekerjaan Umum & Penataan Ruang
                        </span>
                    </div>
                </div>

                <!-- Desktop Menu Nav -->
                <div class="hidden lg:flex items-center space-x-6 text-sm font-semibold text-slate-700">
                    <a href="#beranda" class="text-pupr-blue hover:text-pupr-yellow transition">Beranda</a>
                    <a href="#tracking-surat" class="hover:text-pupr-blue transition flex items-center gap-1.5 bg-slate-100 hover:bg-pupr-yellow/20 px-3.5 py-1.5 rounded-full text-pupr-blue font-bold border border-slate-200">
                        <i class="fa-solid fa-file-contract text-pupr-yellow"></i> Tracking Surat
                    </a>
                    <a href="#layanan" class="hover:text-pupr-blue transition">Layanan Publik</a>
                    <a href="#penanggung-jawab" class="hover:text-pupr-blue transition">Staff Teknis</a>
                    <a href="#kontak" class="hover:text-pupr-blue transition">Kontak</a>
                </div>

                <!-- Action Button -->
                <div class="hidden sm:flex items-center space-x-3">
                    <button onclick="openModalGSheets()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-2 text-xs">
                        <i class="fa-solid fa-file-excel"></i>
                        <span>Sync Google Sheet</span>
                    </button>
                    <a href="#tracking-surat" class="bg-pupr-yellow hover:bg-pupr-hoverYellow text-pupr-blue font-extrabold px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-2 text-xs">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <span>Lacak Surat</span>
                    </a>
                </div>

                <!-- Mobile menu button -->
                <div class="lg:hidden flex items-center">
                    <button id="mobile-menu-btn" class="p-2 rounded-lg text-slate-600 hover:text-pupr-blue hover:bg-slate-100 focus:outline-none">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Dropdown -->
        <div id="mobile-menu" class="hidden lg:hidden border-b border-slate-200 bg-white px-4 pt-2 pb-4 space-y-2 text-sm font-semibold">
            <a href="#beranda" class="block py-2 text-pupr-blue">Beranda</a>
            <a href="#tracking-surat" class="block py-2 text-slate-700 hover:text-pupr-blue"><i class="fa-solid fa-envelope me-2 text-pupr-yellow"></i> Tracking Disposisi Surat</a>
            <a href="#layanan" class="block py-2 text-slate-700 hover:text-pupr-blue">Layanan Publik PUPR</a>
            <a href="#penanggung-jawab" class="block py-2 text-slate-700 hover:text-pupr-blue">Pejabat Penanggung Jawab</a>
            <button onclick="openModalGSheets()" class="w-full text-left py-2 text-emerald-700 font-bold"><i class="fa-solid fa-file-excel me-2"></i> Integrasi Google Spreadsheet</button>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="beranda" class="relative min-h-[640px] flex items-center justify-center overflow-hidden">
        <!-- Background Image with Modern Dark Overlay -->
        <div class="absolute inset-0 z-0">
          <img id="hero-bg"
               src="https://images.unsplash.com/photo-1541888946425-d0fbb186a5b3?q=80&w=1600&auto=format&fit=crop"
               alt="Gedung Dinas PUPR Kota Ambon"
               class="w-full h-full object-cover object-center scale-105 transform transition-opacity duration-1000 opacity-100">
          
          <div class="absolute inset-0 bg-black" style="opacity: 0.5;"></div>
        </div>

        <!-- Floating Decorative Glow Ambient Lights -->
        <div class="absolute -bottom-10 -left-10 w-80 h-80 bg-pupr-yellow/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -top-10 -right-10 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-white w-full">
            <div class="max-w-3xl mx-auto text-center space-y-6">
                
                <!-- Hero Text & Taglines -->
                <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md border border-white/20 px-4 py-1.5 rounded-full text-xs font-bold text-pupr-yellow tracking-wide uppercase shadow-inner mx-auto">
                    <span class="w-2.5 h-2.5 rounded-full bg-pupr-yellow animate-ping"></span>
                    Sistem Layanan Disposisi Digital & Transparansi
                </div>

                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black leading-tight tracking-tight">
                    Mewujudkan <br>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-pupr-yellow via-amber-300 to-yellow-200">
                        Ambon yang Berkelanjutan
                    </span>
                </h1>

                <p class="text-slate-200 text-sm sm:text-lg font-light leading-relaxed mx-auto">
                    Portal terintegrasi Dinas Pekerjaan Umum dan Penataan Ruang Kota Ambon. Pantau status surat masuk, disposisi pimpinan, penanggung jawab teknis, hingga dokumentasi bukti fisik pengerjaan di lapangan secara real-time.
                </p>

                <!-- CTAs -->
                <div class="flex flex-wrap gap-4 pt-2 justify-center">
                    <a href="#tracking-surat" class="bg-pupr-yellow hover:bg-pupr-hoverYellow text-pupr-blue font-extrabold px-7 py-3.5 rounded-2xl shadow-lg yellow-glow transition-all duration-300 transform hover:-translate-y-1 flex items-center gap-3">
                        <i class="fa-solid fa-square-poll-vertical text-lg"></i>
                        <span>Cek Status & Scan Surat</span>
                    </a>
                    <button onclick="openModalAddSurat()" class="bg-white/10 hover:bg-white/20 border border-white/30 text-white font-bold px-6 py-3.5 rounded-2xl backdrop-blur-md transition duration-300 flex items-center gap-2.5">
                        <i class="fa-solid fa-plus-circle text-pupr-yellow"></i>
                        <span>+ Input Surat Baru</span>
                    </button>
                </div>

                <!-- Live Badges -->
                <div class="pt-6 grid grid-cols-3 gap-4 border-t border-white/10 max-w-xl mx-auto text-center">
                    <div>
                        <div class="text-2xl font-black text-pupr-yellow" id="stat-total-surat">0</div>
                        <div class="text-xs text-slate-300">Surat Terdaftar</div>
                    </div>
                    <div>
                        <div class="text-2xl font-black text-emerald-400" id="stat-selesai">0</div>
                        <div class="text-xs text-slate-300">Selesai Ditindaklanjuti</div>
                    </div>
                    <div>
                        <div class="text-2xl font-black text-pupr-yellow">100%</div>
                        <div class="text-xs text-slate-300">Google Sheet Sync</div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- MAIN SECTION: Tracking & Monitoring Surat Masuk -->
    <section id="tracking-surat" class="py-16 bg-slate-100/80 border-t border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Section Title -->
            <div class="text-center max-w-3xl mx-auto mb-10">
                <span class="text-xs font-extrabold uppercase tracking-widest text-pupr-blue bg-pupr-yellow/30 px-3.5 py-1.5 rounded-full border border-pupr-yellow/40">
                    E-Disposisi & Transparansi Pelayanan
                </span>
                <h2 class="text-3xl sm:text-4xl font-black text-pupr-blue mt-3 tracking-tight">
                    Irigasi<br>
                    <span class="text-lg sm:text-2xl font-bold block mt-1">Integrasi Rekam Informasi dan Monitoring Administrasi Surat Instansi</span>
                </h2>
                <p class="text-slate-600 mt-2 text-sm sm:text-base">
                    Monitoring lengkap mencakup Nomor, Tanggal, Penanggung Jawab, Status, Asal, Perihal, Disposisi Pimpinan, Dokumentasi Lapangan, Scan PDF/Foto, serta Terhubung Google Spreadsheet.
                </p>
            </div>

            <!-- Toolbar & Google Sheets Sync Bar -->
            <div class="bg-white rounded-3xl shadow-sm border border-slate-200 p-5 sm:p-6 mb-8">
                
                <!-- Google Sheets Live Connection Bar -->
                <div class="mb-5 pb-5 border-b border-slate-100 flex flex-wrap items-center justify-between gap-4 bg-emerald-50/50 p-4 rounded-2xl border border-emerald-100">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-bold text-xl shadow-md">
                            <i class="fa-solid fa-file-excel"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-black text-sm text-slate-800">Status Google Spreadsheet:</span>
                                <span id="gsheets-status-badge" class="inline-flex items-center px-3 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300">
                                    <span class="w-2 h-2 rounded-full bg-amber-500 me-1.5 animate-pulse"></span>
                                    Demo Mode (Data Lokal)
                                </span>
                            </div>
                            <p class="text-[11px] text-slate-500 mt-0.5" id="gsheets-last-sync-text">Klik 'Hubungkan Google Sheet' untuk sinkronisasi live dengan database cloud Anda.</p>
                        </div>
                    </div>

                    <div class="flex items-center space-x-2">
                        <button onclick="syncGoogleSheetsData()" id="btn-sync-gsheets" class="bg-white hover:bg-slate-100 text-slate-700 text-xs font-bold px-3.5 py-2.5 rounded-xl border border-slate-300 transition flex items-center gap-1.5 shadow-sm">
                            <i class="fa-solid fa-rotate text-pupr-blue"></i>
                            <span>Muat Ulang Data</span>
                        </button>
                        <button onclick="openModalGSheets()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow transition flex items-center gap-2">
                            <i class="fa-solid fa-plug"></i>
                            <span>Hubungkan Google Sheet</span>
                        </button>
                    </div>
                </div>

                <!-- Search and Status Filter Row -->
                <div class="flex flex-col lg:flex-row gap-4 items-center justify-between">
                    
                    <!-- Search Input -->
                    <div class="w-full lg:w-1/2 relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-slate-400"></i>
                        <input type="text" id="search-surat-input" onkeyup="filterSuratTable()" 
                               placeholder="Cari nomor surat, perihal, pengirim, atau penanggung jawab..." 
                               class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-pupr-blue focus:outline-none transition">
                    </div>

                    <!-- Status Filters -->
                    <div class="flex flex-wrap items-center gap-2 w-full lg:w-auto justify-start lg:justify-end">
                        <button onclick="setFilterStatus('ALL')" class="status-btn active-status-btn px-4 py-2 rounded-xl text-xs font-bold transition bg-pupr-blue text-white shadow-sm" id="btn-status-all">
                            Semua Surat
                        </button>
                        <button onclick="setFilterStatus('SELESAI')" class="status-btn px-4 py-2 rounded-xl text-xs font-bold transition bg-slate-100 text-slate-600 hover:bg-emerald-50 hover:text-emerald-700" id="btn-status-selesai">
                            <i class="fa-solid fa-circle-check text-emerald-500 me-1"></i> Selesai
                        </button>
                        <button onclick="setFilterStatus('PROSES')" class="status-btn px-4 py-2 rounded-xl text-xs font-bold transition bg-slate-100 text-slate-600 hover:bg-amber-50 hover:text-amber-700" id="btn-status-proses">
                            <i class="fa-solid fa-spinner text-amber-500 me-1"></i> Diproses
                        </button>
                        <button onclick="setFilterStatus('DISPOSISI')" class="status-btn px-4 py-2 rounded-xl text-xs font-bold transition bg-slate-100 text-slate-600 hover:bg-blue-50 hover:text-blue-700" id="btn-status-disposisi">
                            <i class="fa-solid fa-share text-blue-500 me-1"></i> Disposisi
                        </button>
                        <button onclick="openModalAddSurat()" class="bg-pupr-yellow hover:bg-pupr-hoverYellow text-pupr-blue font-extrabold px-3.5 py-2 rounded-xl text-xs transition flex items-center gap-1 shadow-sm">
                            <i class="fa-solid fa-plus"></i> Tambah
                        </button>
                    </div>
                </div>
            </div>

            <!-- Surat Data Table Container -->
            <div class="bg-white rounded-3xl shadow-md border border-slate-200 overflow-hidden">
                <div class="overflow-x-auto custom-scrollbar">
                    <table class="w-full text-left border-collapse" id="table-surat">
                        <thead>
                            <tr class="bg-pupr-blue text-white text-[11px] uppercase font-black tracking-wider border-b border-slate-700">
                                <th class="p-4 w-12 text-center">#</th>
                                <th class="p-4">Nomor & Tanggal</th>
                                <th class="p-4">Asal Surat</th>
                                <th class="p-4">Perihal Surat</th>
                                <th class="p-4">Penanggung Jawab</th>
                                <th class="p-4 text-center">Status</th>
                                <th class="p-4 text-center">Aksi (Scan & Dokumentasi)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 text-sm font-medium" id="surat-list-tbody">
                            <!-- Dynamically Generated via JS -->
                        </tbody>
                    </table>
                </div>

                <!-- Footer Counter Info -->
                <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500 gap-3">
                    <div>Menampilkan <span class="font-bold text-slate-800" id="count-visible">0</span> dari <span class="font-bold text-slate-800" id="count-total">0</span> data surat terdaftar</div>
                    <div class="flex items-center space-x-2">
                        <span class="text-slate-400"><i class="fa-solid fa-circle-info me-1"></i> Klik <b>"Detail Disposisi & Scan"</b> untuk melihat scan isi surat & foto bukti lapangan.</span>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- MODAL 1: Detail Lengkap Surat -->
    <div id="modal-detail-surat" class="fixed inset-0 z-50 hidden bg-slate-900/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-3xl max-w-4xl w-full shadow-2xl border border-slate-200 my-8 overflow-hidden transform transition-all duration-300">
            
            <!-- Modal Header -->
            <div class="bg-pupr-blue text-white px-6 py-4 flex justify-between items-center border-b border-slate-700">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-pupr-yellow text-pupr-blue font-black flex items-center justify-center text-xl">
                        <i class="fa-solid fa-file-signature"></i>
                    </div>
                    <div>
                        <h3 class="font-extrabold text-lg leading-snug">Rincian Tracking & Disposisi Surat Digital</h3>
                        <p class="text-xs text-slate-300">Dinas Pekerjaan Umum & Penataan Ruang Kota Ambon</p>
                    </div>
                </div>
                <button onclick="closeModalDetail()" class="text-slate-300 hover:text-white p-2 rounded-xl hover:bg-white/10 transition">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 space-y-6 max-h-[80vh] overflow-y-auto custom-scrollbar">
                
                <!-- Status Banner & Last Sync Badge -->
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 flex flex-wrap items-center justify-between gap-4">
                    <div>
                        <span class="text-[10px] text-slate-500 font-extrabold uppercase tracking-wider block mb-1">Status Surat Saat Ini</span>
                        <div id="modal-status-badge"></div>
                    </div>
                    <div>
                        <span class="text-[10px] text-slate-500 font-extrabold uppercase tracking-wider block mb-1">Bidang Kerja PUPR</span>
                        <span class="text-xs font-bold text-pupr-blue bg-blue-50 px-3 py-1 rounded-full border border-blue-200" id="modal-bidang">-</span>
                    </div>
                    <div>
                        <span class="text-[10px] text-slate-500 font-extrabold uppercase tracking-wider block mb-1">Terakhir Diperbarui</span>
                        <span class="text-xs font-semibold text-slate-700" id="modal-last-update">-</span>
                    </div>
                </div>

                <!-- 2-Column Metadata Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    
                    <!-- Nomor Surat & Tanggal Surat -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                        <div class="border-b pb-2.5 flex items-center justify-between">
                            <span class="text-xs font-extrabold uppercase text-slate-500"><i class="fa-solid fa-hashtag text-pupr-yellow me-1.5"></i> Nomor Surat</span>
                            <span class="text-sm font-black text-pupr-blue" id="modal-nomor-surat">-</span>
                        </div>
                        <div class="flex items-center justify-between pt-1">
                            <span class="text-xs font-extrabold uppercase text-slate-500"><i class="fa-regular fa-calendar-check text-pupr-yellow me-1.5"></i> Tanggal Surat</span>
                            <span class="text-sm font-bold text-slate-800" id="modal-tanggal-surat">-</span>
                        </div>
                    </div>

                    <!-- Asal Surat & Penanggung Jawab Surat -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                        <div class="border-b pb-2.5 flex items-center justify-between">
                            <span class="text-xs font-extrabold uppercase text-slate-500"><i class="fa-solid fa-building-flag text-pupr-yellow me-1.5"></i> Asal Surat</span>
                            <span class="text-sm font-bold text-slate-800 text-right" id="modal-asal-surat">-</span>
                        </div>
                        <div class="flex items-center justify-between pt-1">
                            <span class="text-xs font-extrabold uppercase text-slate-500"><i class="fa-solid fa-user-gear text-pupr-yellow me-1.5"></i> Penanggung Jawab</span>
                            <div class="text-right" id="modal-pj-container"></div>
                        </div>
                    </div>

                </div>

