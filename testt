                            },
                            status: (item.Status || "PROSES").toUpperCase(),
                            statusText: (item.Status || "").toUpperCase() === "SELESAI" ? "Selesai Ditindaklanjuti" : "Dalam Proses Lapangan",
                            statusClass: (item.Status || "").toUpperCase() === "SELESAI" ? "bg-emerald-100 text-emerald-800 border-emerald-300" : "bg-amber-100 text-amber-800 border-amber-300",
                            scanSuratUrl: item.ScanURL || "https://images.unsplash.com/photo-1568667256549-094345857637?q=80&w=800&auto=format&fit=crop",
                            dokumentasiPhotos: item.FotoLapangan ? [item.FotoLapangan] : ["https://images.unsplash.com/photo-1541888946425-d0fbb186a5b3?q=80&w=800&auto=format&fit=crop"],
                            catatanLapangan: item.Catatan || "-"
                        };
                    });

                    renderSuratTable(DATA_SURAT_PUPR);
                    updateStatsCounters();

                    if(badge) {
                        badge.className = "inline-flex items-center px-3 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300";
                        badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500 me-1.5"></span> Live Google Sheets Connected`;
                    }
                    if(syncText) syncText.innerText = `Terakhir disinkronkan: ${new Date().toLocaleTimeString('id-ID')} WIT`;
                    showToast("Data surat berhasil disinkronkan dari Google Spreadsheet!", "success");
                } else {
                    throw new Error("Data Google Sheet kosong.");
                }
            } catch (err) {
                console.error(err);
                if(badge) {
                    badge.className = "inline-flex items-center px-3 py-0.5 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-300";
                    badge.innerHTML = `<i class="fa-solid fa-triangle-exclamation me-1.5"></i> Gagal Koneksi`;
                }
                if(syncText) syncText.innerText = "Gagal memuat spreadsheet. Menampilkan data lokal.";
                showToast("Gagal menghubungkan Google Sheet.", "error");
                renderSuratTable(DATA_SURAT_DEMO);
                updateStatsCounters();
            } finally {
                if(btnSync) btnSync.classList.remove('opacity-50', 'pointer-events-none');
            }
        }

