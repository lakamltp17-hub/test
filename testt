                id: Date.now(),
                nomorSurat: document.getElementById('add-nomor').value,
                tanggalSurat: document.getElementById('add-tanggal').value,
                asalSurat: document.getElementById('add-asal').value,
                perihalSurat: document.getElementById('add-perihal').value,
                disposisiPimpinan: document.getElementById('add-disposisi').value,
                bidang: bidang,
                pj: OFFICERS_DATA[bidang] || OFFICERS_DATA["Hermin Taranda, ST"],
                status: "PROSES",
                statusText: "Proses Baru Masuk",
                statusClass: "bg-amber-100 text-amber-800 border-amber-300",
                dokumentasiPhotos: ["https://images.unsplash.com/photo-1541888946425-d0fbb186a5b3?q=80&w=800&auto=format&fit=crop"],
                catatanLapangan: "Baru saja diinput ke sistem e-disposisi PUPR.",
                scanSuratUrl: "https://images.unsplash.com/photo-1568667256549-094345857637?q=80&w=800&auto=format&fit=crop",
                lastUpdate: new Date().toLocaleTimeString('id-ID')
            };

            DATA_SURAT_PUPR.unshift(newObj);
            renderSuratTable(DATA_SURAT_PUPR);
            updateStatsCounters();
            closeModalAddSurat();
            showToast("Surat baru berhasil ditambahkan!", "success");
        }

        function renderOfficersGrid() {
            const grid = document.getElementById('pj-officers-grid');
            if(!grid) return;
            grid.innerHTML = '';
            Object.keys(OFFICERS_DATA).forEach(key => {
                const off = OFFICERS_DATA[key];
                grid.innerHTML += `
                    <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm text-center flex flex-col items-center">
                        <img src="${off.avatar}" class="w-16 h-16 rounded-full object-cover border-2 border-pupr-yellow shadow-md mb-3">
                        <h4 class="font-extrabold text-sm text-pupr-blue">${off.nama}</h4>
                        <p class="text-xs text-slate-500 font-semibold">${off.jabatan}</p>
                        <span class="mt-3 text-[10px] bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full border border-slate-200 font-mono">NIP: ${off.nip}</span>
                    </div>
                `;
            });
        }

        function updateStatsCounters() {
            const totalEl = document.getElementById('stat-total-surat');
            const selesaiEl = document.getElementById('stat-selesai');
            if(totalEl) totalEl.innerText = DATA_SURAT_PUPR.length;
            if(selesaiEl) selesaiEl.innerText = DATA_SURAT_PUPR.filter(x => x.status === 'SELESAI').length;
        }

        function simulateDownloadDoc() {
            if(currentActiveModalData) {
                showToast(`Mengunduh scan isi surat: ${currentActiveModalData.nomorSurat}`, 'success');
            }
        }

        function setupMobileMenu() {
            const btn = document.getElementById('mobile-menu-btn');
            const menu = document.getElementById('mobile-menu');
            if (btn && menu) {
                btn.addEventListener('click', () => menu.classList.toggle('hidden'));
            }
        }

        function showToast(message, type = "success") {
            const toast = document.getElementById('toast-message');
            const icon = document.getElementById('toast-icon');
            const text = document.getElementById('toast-text');
            if(!toast) return;

            text.innerText = message;
            if (type === "success") {
                icon.className = "fa-solid fa-circle-check text-emerald-400 text-lg";
            } else {
                icon.className = "fa-solid fa-triangle-exclamation text-rose-400 text-lg";
            }

            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 3500);
        }

        // Background Slider for Hero Section
        function initHeroSlider() {
            const images = [
                "https://images.unsplash.com/photo-1541888946425-d0fbb186a5b3?q=80&w=1600&auto=format&fit=crop",
                "https://images.unsplash.com/photo-1581094794329-c8112a89af12?q=80&w=1600&auto=format&fit=crop",
                "https://images.unsplash.com/photo-1590496793929-36417d3117de?q=80&w=1600&auto=format&fit=crop"
            ];

            let currentIndex = 0;
            const heroBg = document.getElementById('hero-bg');
            if (!heroBg) return;

            setInterval(() => {
                heroBg.classList.remove('opacity-100');
                heroBg.classList.add('opacity-0');

                setTimeout(() => {
                    currentIndex = (currentIndex + 1) % images.length;
                    heroBg.src = images[currentIndex];

                    heroBg.classList.remove('opacity-0');
                    heroBg.classList.add('opacity-100');
                }, 500);
            }, 5000);
        }
    </script>
</body>
</html>
