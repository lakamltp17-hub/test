                            id: idx + 1,
                            nomorSurat: item.NomorSurat || "-",
                            tanggalSurat: item.Tanggal || "-",
                            asalSurat: item.AsalSurat || "-",
                            perihalSurat: item.Perihal || "-",
                            disposisiPimpinan: item.Disposisi || "Petunjuk Pimpinan",
